# Битрикс24 (общий с bot/, копируем значение)
BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/<webhook-key>/

# Кто ответственный за создаваемые Сделки. На портале veloce единственный пользователь — ID=1.
ASSIGNED_BY_ID=1

# Offline analytics worker (Bitrix24 → Yandex Metrika Simple Orders).
# Keep disabled until the deploy migration and Yandex goals are ready.
ANALYTICS_ENABLED=false
# Stable Bitrix24 portal member_id from the accepted analytics contract.
# Resolve it out-of-band once; never substitute a mutable hostname or webhook secret.
BITRIX24_PORTAL_ID=00000000-0000-0000-0000-000000000000
YANDEX_METRIKA_COUNTER_ID=109782828
YANDEX_OAUTH_TOKEN=
ANALYTICS_POLL_INTERVAL_MS=300000
ANALYTICS_UPLOAD_INTERVAL_MS=30000
ANALYTICS_RECONCILE_INTERVAL_MS=60000
ANALYTICS_OUTBOX_ALERT_THRESHOLD=100

# CORS allow-list (JSON-массив строк).
# veloce.team — основной сайт. maxbot-pro.ru — продуктовый сайт
# max-microsite, фронт делает cross-origin POST на /api/lead/maxbot.
CORS_ORIGINS=["https://veloce.team","https://www.veloce.team","https://maxbot-pro.ru"]

# Rate-limit
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5

# SQLite
DB_PATH=/data/web.sqlite

# Idempotency
IDEMPOTENCY_TTL_MS=600000

# TG-нотификация лидов (опционально, оба или ни одного)
# Production: URL → https://bot.veloce.team/internal/notify-lead
# SECRET — общий с bot/.env (32+ байт hex, openssl rand -hex 32)
# Если оба пусты — лиды идут в B24, но в TG-группу не сигналятся.
LEAD_NOTIFICATION_URL=
LEAD_NOTIFICATION_SECRET=

# HTTP-server
PORT=3000

# Логирование
LOG_LEVEL=info
NODE_ENV=production
